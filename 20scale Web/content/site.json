  "forms": {
    "backend": "Google Apps Script Web App (doPost) -> appends row to Google Sheet + MailApp.sendEmail to company.contact.email",
    "notifyEmail": "20scalesolutions@gmail.com",
    "types": {
      "contact": [
        "name*",
        "phone*",
        "email",
        "message*"
      ],
      "quoteRequest": [
        "name*",
        "phone*",
        "businessName",
        "email",
        "district",
        "businessType",
        "package",
        "stations",
        "branches",
        "hardwareSelection",
        "extras",
        "estimatedTotal",
        "breakdownJSON",
        "notes"
      ],
      "customRequirement": [
        "name*",
        "phone*",
        "businessName",
        "requirementText*"
      ],
      "consultation": [
        "name*",
        "phone*",
        "preferredTime",
        "topic"
      ]
    },
    "sheetColumns": [
      "timestamp",
      "formType",
      "lang",
      "name",
      "phone",
      "email",
      "businessName",
      "district",
      "businessType",
      "payloadJSON",
      "sourcePage"
    ],
    "protection": [
      "honeypot field",
      "client-side validation",
      "rate-limit in Apps Script (LockService)",
      "no personal data beyond what the user typed"
    ],
    "successUx": "Show confirmation + 'We'll contact you within [x hours]' + WhatsApp button",
    "responseTimePromise": null
  },
  "seo": {
    "keywords": {
      "en": [
        "POS system Sri Lanka",
        "POS price Sri Lanka",
        "custom software Sri Lanka",
        "offline POS",
        "inventory software Sri Lanka",
        "POS system price calculator"
      ],
      "si": [
        "ශ්‍රී ලංකාවේ POS පද්ධති",
        "POS මිල ශ්‍රී ලංකාව",
        "custom මෘදුකාංග"
      ]
    },
    "perPage": "unique title (<60 chars), description (<155 chars), OG image (logo on dark), canonical",
    "structuredData": [
      "Organization",
      "FAQPage",
      "Service"
    ],
    "files": [
      "sitemap.xml",
      "robots.txt"
    ],
    "limitations": "Without a custom domain, ranking for 'POS Sri Lanka' will be very hard. Treat the free URL as a launch/clients-demo phase."
  },
  "analytics": {
    "recommended": [
      "Google Search Console (free)",
      "Vercel/Cloudflare built-in analytics or none",
      "track clicks on WhatsApp + quote submissions as events"
    ],
    "ownerKnowledge": "none -- keep minimal, no cookie banner needed if no tracking cookies"
  },
  "performance": {
    "targets": "Lighthouse >= 90 mobile; images WebP/AVIF; fonts subset incl. Sinhala; JS minimal"
  },
  "accessibility": [
    "contrast AA on dark theme",
    "keyboard navigable",
    "reduced-motion respected",
    "alt text"
  ],
  "legal": {
    "privacy": "short text: what the forms collect, stored in Google Sheet, used only to contact you",
    "terms": "generate from process-support.json (exclusions, SLA, refund, warranty)",
    "cookies": "not required if no tracking cookies",
    "note": "Not a lawyer. Have terms reviewed when the company is registered."
  }
}