---
import type { Lang } from '../i18n/index';
import { t } from '../i18n/index';
import companyData from '../../content/company.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const phone = companyData.contact?.phone;
const email = companyData.contact?.email;
const operatingArea = companyData.operatingModel?.serviceArea || 'Sri Lanka';

const navLinks = [
  { key: 'nav.home',      path: '/' },
  { key: 'nav.solutions', path: '/solutions' },
  { key: 'nav.pricing',   path: '/pricing' },
  { key: 'nav.process',   path: '/process' },
  { key: 'nav.about',     path: '/about' },
  { key: 'nav.faq',       path: '/faq' },
  { key: 'nav.contact',   path: '/contact' },
] as const;

function resolveHref(path: string): string {
  if (lang === 'en') {
    return path === '/' ? '/en' : `/en${path}`;
  }
  return path;
}
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-inner">
    <!-- Brand -->
    <div class="footer-brand">
      <a href={lang === 'en' ? '/en' : '/'} class="footer-logo" aria-label="20Scale – Home">
        2<span class="logo-zero">0</span>Scale
      </a>
      <p class="footer-tagline">{t(lang, 'footer.tagline')}</p>
      
      <div class="footer-contacts">
        {email && (
          <a href={`mailto:${email}`} class="footer-contact-link">
            <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>{email}</span>
          </a>
        )}
        {phone?.link && (
          <a href={phone.link} class="footer-contact-link">
            <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>{phone.number}</span>
          </a>
        )}
      </div>
    </div>

    <!-- Nav links -->
    <nav class="footer-nav" aria-label="Footer navigation">
      <h3 class="footer-nav-title">{lang === 'si' ? 'පිටු සහ සබැඳි' : 'Quick Navigation'}</h3>
      <div class="nav-links-grid">
        {navLinks.map(({ key, path }) => (
          <a href={resolveHref(path)} class="footer-link">
            {t(lang, key)}
          </a>
        ))}
      </div>
    </nav>
  </div>

  <!-- Copyright -->
  <div class="footer-bottom">
    <p class="footer-copy">{t(lang, 'footer.copyright')}</p>
    <p class="footer-area">{operatingArea}</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 2.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  /* ---- Brand column ---- */
  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .logo-zero {
    color: var(--color-primary);
  }

  .footer-tagline {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 36ch;
    margin-bottom: 1.25rem;
  }

  .footer-contacts {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }
  .footer-contact-link:hover {
    color: var(--color-primary);
  }

  .contact-icon {
    width: 16px;
    height: 16px;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  /* ---- Nav column ---- */
  .footer-nav-title {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .nav-links-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.625rem 1.5rem;
  }

  .footer-link {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    padding: 0.25rem 0;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .footer-link:hover {
    color: var(--color-primary);
  }

  /* ---- Bottom bar ---- */
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: 1.25rem 1.25rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: space-between;
    align-items: center;
  }

  .footer-copy {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .footer-area {
    color: var(--color-text-muted);
    font-size: 0.775rem;
  }

  /* ---- Responsive ---- */
  @media (min-width: 640px) {
    .footer-inner {
      grid-template-columns: 1.2fr 1fr;
    }
    .footer-bottom {
      flex-direction: row;
    }
  }

  /* ---- Reduced motion ---- */
  @media (prefers-reduced-motion: reduce) {
    .footer-contact-link,
    .footer-link {
      transition: none !important;
    }
  }
</style>
