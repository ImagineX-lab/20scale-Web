---
import companyData from '../../../content/company.json';
import proofData from '../../../content/proof.json';
import type { Lang } from '../../i18n/index';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const story = companyData.story;
const mission = companyData.mission[lang];
const vision = companyData.vision[lang];
const delivered = companyData.deliveredProjects;
const operatingModel = companyData.operatingModel;
---

<section class="about-section" aria-labelledby="about-heading">
  <div class="about-container">
    <div class="section-header">
      <span class="section-tag">
        {lang === 'si' ? 'අප ගැන' : 'About 20Scale'}
      </span>
      <h1 id="about-heading" class="section-title">
        {lang === 'si' ? (
          <>
            දේශීය ව්‍යාපාරික අවශ්‍යතා සහ <span class="text-cyan">Enterprise ඉංජිනේරු විද්‍යාව</span>
          </>
        ) : (
          <>
            Bridging Local Retail Realities & <span class="text-cyan">Enterprise Engineering</span>
          </>
        )}
      </h1>
      <p class="section-sub">
        {companyData.tagline[lang]}
      </p>
    </div>

    <!-- Verified Metrics Row -->
    <div class="metrics-grid">
      <div class="metric-card">
        <span class="metric-val">100%</span>
        <h3 class="metric-title">Offline-First</h3>
        <p class="metric-sub">{lang === 'si' ? 'අන්තර්ජාලය නැතිව ක්‍රියාකාරිත්වය' : 'Zero internet dependency'}</p>
      </div>

      <div class="metric-card">
        <span class="metric-val">{delivered.count}</span>
        <h3 class="metric-title">{lang === 'si' ? 'ස්ථාපිත POS පද්ධති' : 'Delivered POS Systems'}</h3>
        <p class="metric-sub">{lang === 'si' ? 'සත්‍යාපිත ව්‍යාපාරික පද්ධති' : 'Verified commercial deployments'}</p>
      </div>

      <div class="metric-card">
        <span class="metric-val">Island-wide</span>
        <h3 class="metric-title">{lang === 'si' ? 'දිවයින පුරා සේවාව' : 'Island-wide Service'}</h3>
        <p class="metric-sub">{lang === 'si' ? 'සේවා ස්ථානයට පැමිණීම' : 'On-site discovery & training'}</p>
      </div>
    </div>

    <!-- Story Box -->
    <div class="story-card">
      <h2 class="story-title">{story.title[lang]}</h2>
      <div class="story-paragraphs">
        {story.paragraphs.map((p) => (
          <p>{p[lang]}</p>
        ))}
      </div>
    </div>

    <!-- Vision & Mission Grid -->
    <div class="vision-mission-grid">
      <div class="vm-card">
        <div class="vm-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </div>
        <h2 class="vm-title">{lang === 'si' ? 'අපගේ දැක්ම (Vision)' : 'Our Vision'}</h2>
        <p class="vm-text">{vision}</p>
      </div>

      <div class="vm-card">
        <div class="vm-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h2 class="vm-title">{lang === 'si' ? 'අපගේ මෙහෙවර (Mission)' : 'Our Mission'}</h2>
        <p class="vm-text">{mission}</p>
      </div>
    </div>

    <!-- Operating Model & Work Ethic -->
    <div class="operating-card">
      <h2 class="op-title">{lang === 'si' ? 'අපගේ මෙහෙයුම් ආකෘතිය (Operating Model)' : 'How We Operate'}</h2>
      <p class="op-text">
        <strong>{lang === 'si' ? 'දුරස්ථ ප්‍රමුඛ (Remote-First):' : 'Remote-First Architecture:'}</strong>
        {lang === 'si'
          ? 'අපගේ මූලික ඉංජිනේරු කටයුතු Remote-first ලෙස ක්‍රියාත්මක වන අතර, ව්‍යාපාරික ස්ථානයට පැමිණ අවශ්‍යතා හඳුනාගැනීම, install කිරීම, data migration සහ training ලබාදීම සඳහා දිවයින පුරා සේවා ස්ථානයටම පැමිණෙමු.'
          : 'We operate as an agile, remote-first software engineering team. In-person visits for discovery, installation, ledger entry, and staff training are arranged across Sri Lanka per project.'}
      </p>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 4.5rem 1.25rem 6rem;
    position: relative;
  }

  .about-container {
    max-width: 1050px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 3.5rem;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: rgba(0, 229, 229, 0.1);
    padding: 0.25rem 0.875rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .text-cyan {
    color: var(--color-primary);
  }

  .section-sub {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 640px) {
    .metrics-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .metric-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .metric-val {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .metric-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .metric-sub {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .story-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 2.5rem 2rem;
    margin-bottom: 3rem;
  }

  .story-title {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 1.5rem;
    line-height: 1.3;
  }

  .story-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .vision-mission-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .vision-mission-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .vm-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 2.25rem 2rem;
  }

  .vm-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(0, 229, 229, 0.1);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .vm-icon svg {
    width: 24px;
    height: 24px;
  }

  .vm-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.875rem;
  }

  .vm-text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .operating-card {
    background: rgba(7, 16, 28, 0.7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 2rem;
  }

  .op-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .op-text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .op-text strong {
    color: var(--color-text);
  }
</style>
