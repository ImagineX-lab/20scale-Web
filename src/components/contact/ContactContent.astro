---
import companyData from '../../../content/company.json';
import type { Lang } from '../../i18n/index';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const whatsapp = companyData.contact?.whatsapp;
const phone = companyData.contact?.phone;
const email = companyData.contact?.email;
const operatingArea = companyData.operatingModel?.serviceArea || 'Island-wide (Sri Lanka)';

const defaultMsg = lang === 'si'
  ? 'හෙලෝ 20Scale, මගේ ව්‍යාපාරයට මෘදුකාංග / POS විසඳුමක් ගැන කතා කිරීමට අවශ්‍යයි.'
  : 'Hello 20Scale, I would like to consult with you regarding a software / POS system for my business.';

const waLink = whatsapp?.link ? `${whatsapp.link}?text=${encodeURIComponent(defaultMsg)}` : null;
---

<section class="contact-page-section" aria-labelledby="contact-page-heading">
  <div class="contact-page-container">
    <div class="section-header">
      <span class="section-tag">
        {lang === 'si' ? 'අප අමතන්න' : 'Direct Communication'}
      </span>
      <h1 id="contact-page-heading" class="section-title">
        {lang === 'si' ? (
          <>
            ඔබේ ව්‍යාපාරයේ ගැටලු ගැන <span class="text-cyan">අප සමඟ කතා කරන්න</span>
          </>
        ) : (
          <>
            Start Your Software Discovery: <span class="text-cyan">Contact Our Engineering Team</span>
          </>
        )}
      </h1>
      <p class="section-sub">
        {lang === 'si'
          ? 'නොමිලේ උපදේශනයක් සඳහා අප හා සම්බන්ධ වන්න. ඔබගේ ව්‍යාපාරික ස්ථානයටම පැමිණ හෝ දුරකථනයෙන් අවශ්‍යතා සාකච්ඡා කළ හැක.'
          : 'Reach out directly via WhatsApp, phone or send us an inquiry. In-person on-site visits arranged island-wide.'}
      </p>
    </div>

    <div class="contact-grid">
      <!-- Contact Direct Cards -->
      <div class="contact-info-col">
        <div class="channel-card">
          <div class="channel-icon-wrap wa-icon-bg" aria-hidden="true">
            <svg class="channel-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-5.805 1.554zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
            </svg>
          </div>
          <div>
            <h2 class="channel-title">WhatsApp Support</h2>
            <p class="channel-val">{whatsapp?.number}</p>
            <p class="channel-hint">{lang === 'si' ? 'ක්ෂණික පණිවිඩ සහ screenshots යැවීමට' : 'Fastest response for chat & media'}</p>
            {waLink && (
              <a href={waLink} target="_blank" rel="noopener noreferrer" class="channel-btn btn-wa-inline">
                {lang === 'si' ? 'WhatsApp හරහා කතා කරන්න' : 'Chat on WhatsApp'}
              </a>
            )}
          </div>
        </div>

        <div class="channel-card">
          <div class="channel-icon-wrap cyan-icon-bg" aria-hidden="true">
            <svg class="channel-svg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <h2 class="channel-title">{lang === 'si' ? 'සෘජු Hotline' : 'Direct Hotline'}</h2>
            <p class="channel-val">{phone?.number}</p>
            <p class="channel-hint">{lang === 'si' ? '24/7 ඇමතුම් සඳහා විවෘතයි' : '24/7 Available for inquiries'}</p>
            {phone?.link && (
              <a href={phone.link} class="channel-btn btn-phone-inline">
                {lang === 'si' ? 'දැන්ම අමතන්න' : 'Call Now'}
              </a>
            )}
          </div>
        </div>

        <div class="channel-card">
          <div class="channel-icon-wrap cyan-icon-bg" aria-hidden="true">
            <svg class="channel-svg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h2 class="channel-title">Email</h2>
            <p class="channel-val">{email}</p>
            <p class="channel-hint">{lang === 'si' ? 'නිල ලේඛන සහ විමසීම් සඳහා' : 'For formal proposals & RFP'}</p>
            <a href={`mailto:${email}`} class="channel-btn btn-email-inline">
              {lang === 'si' ? 'Email එකක් එවන්න' : 'Send Email'}
            </a>
          </div>
        </div>

        <div class="location-banner">
          <svg class="loc-pin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
          </svg>
          <div>
            <strong>{lang === 'si' ? 'සේවා ප්‍රදේශය:' : 'Service Coverage:'}</strong>
            <span> {operatingArea}</span>
            <p class="loc-sub">{companyData.operatingModel.onSite[lang]}</p>
          </div>
        </div>
      </div>

      <!-- Quick Consultation Request Form -->
      <div class="contact-form-panel">
        <h2 class="form-title">{lang === 'si' ? 'නොමිලේ උපදේශන පණිවිඩයක් එවන්න' : 'Request Discovery Call'}</h2>
        <p class="form-desc">
          {lang === 'si'
            ? 'පහත පෝරමය පුරවන්න. අපගේ ඉංජිනේරුවෙකු කෙටි වේලාවක් තුළ ඔබව අමතනු ඇත.'
            : 'Fill in your details below. Our team will contact you promptly to schedule a free discovery session.'}
        </p>

        <form id="contact-inquiry-form" class="inquiry-form" onsubmit="return false;">
          <div class="form-field">
            <label for="contact-name">{lang === 'si' ? 'ඔබගේ නම *' : 'Your Name *'}</label>
            <input type="text" id="contact-name" required placeholder={lang === 'si' ? 'කසුන් පෙරේරා' : 'John Perera'} />
          </div>

          <div class="form-field">
            <label for="contact-phone">{lang === 'si' ? 'දුරකථන / WhatsApp අංකය *' : 'Phone / WhatsApp *'}</label>
            <input type="tel" id="contact-phone" required placeholder="07X XXX XXXX" />
          </div>

          <div class="form-field">
            <label for="contact-biz">{lang === 'si' ? 'ව්‍යාපාරයේ නම සහ නගරය' : 'Business Name & City'}</label>
            <input type="text" id="contact-biz" placeholder={lang === 'si' ? 'උදා: රත්නායක හාඩ්වෙයාර් - කුරුණෑගල' : 'e.g., City Hardware - Kandy'} />
          </div>

          <div class="form-field">
            <label for="contact-msg">{lang === 'si' ? 'ඔබගේ අවශ්‍යතාවය කෙටියෙන්' : 'Your Message / Requirement'}</label>
            <textarea id="contact-msg" rows="4" placeholder={lang === 'si' ? 'උදා: අපට 100% offline වැඩ කරන බිල්පත් සහ තොග පද්ධතියක් අවශ්‍යයි...' : 'e.g., We need an offline POS with multi-counter billing and barcode printing...'}></textarea>
          </div>

          <button type="button" id="btn-submit-contact" class="btn-submit-inquiry">
            <span>{lang === 'si' ? 'පණිවිඩය යවන්න' : 'Submit Inquiry'}</span>
            <svg class="submit-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          <div id="contact-form-status" class="form-status" style="display: none;"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ lang, whatsappNum: whatsapp?.number }}>
  const formBtn = document.getElementById('btn-submit-contact');
  const nameInput = document.getElementById('contact-name');
  const phoneInput = document.getElementById('contact-phone');
  const bizInput = document.getElementById('contact-biz');
  const msgInput = document.getElementById('contact-msg');
  const statusEl = document.getElementById('contact-form-status');

  if (formBtn) {
    formBtn.addEventListener('click', () => {
      const name = nameInput.value.trim();
      const phone = phoneInput.value.trim();
      const biz = bizInput.value.trim();
      const msg = msgInput.value.trim();

      if (!name || !phone) {
        alert(lang === 'si' ? 'කරුණාකර ඔබගේ නම සහ දුරකථන අංකය ඇතුළත් කරන්න.' : 'Please enter your Name and Phone number.');
        phoneInput.focus();
        return;
      }

      if (statusEl) {
        statusEl.style.display = 'block';
        statusEl.className = 'form-status status-success';
        const waText = encodeURIComponent(`Hello 20Scale, I am ${name}. ${biz ? 'Business: ' + biz + '. ' : ''}${msg ? 'Message: ' + msg : ''}`);
        const waLink = `https://wa.me/${whatsappNum.replace(/\+/g, '')}?text=${waText}`;

        statusEl.innerHTML = lang === 'si'
          ? `<strong>ස්තූතියි ${name}!</strong> ඔබගේ පණිවිඩය සටහන් කරගන්නා ලදී. අපගේ කණ්ඩායම කෙටි වේලාවකින් (${phone}) අංකයට කතා කරනු ඇත. <br><br><a href="${waLink}" target="_blank" class="status-wa-link">ක්ෂණිකව WhatsApp හරහා සම්බන්ධ වන්න &rarr;</a>`
          : `<strong>Thank you ${name}!</strong> Your inquiry is received. We will contact you shortly on ${phone}. <br><br><a href="${waLink}" target="_blank" class="status-wa-link">Connect directly on WhatsApp &rarr;</a>`;
      }
    });
  }
</script>

<style>
  .contact-page-section {
    padding: 4.5rem 1.25rem 6rem;
    position: relative;
  }

  .contact-page-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 3.5rem;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: rgba(0, 229, 229, 0.1);
    padding: 0.25rem 0.875rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .text-cyan {
    color: var(--color-primary);
  }

  .section-sub {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .channel-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1.75rem;
    transition: border-color 0.2s;
  }

  .channel-card:hover {
    border-color: rgba(0, 229, 229, 0.4);
  }

  .channel-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .wa-icon-bg {
    background: rgba(37, 211, 102, 0.15);
    color: #25D366;
  }

  .cyan-icon-bg {
    background: rgba(0, 229, 229, 0.12);
    color: var(--color-primary);
  }

  .channel-svg {
    width: 24px;
    height: 24px;
  }

  .channel-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .channel-val {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .channel-hint {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 0.875rem;
  }

  .channel-btn {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    transition: background 0.2s, color 0.2s;
  }

  .btn-wa-inline {
    background: #25D366;
    color: #00030B;
  }

  .btn-phone-inline {
    background: var(--color-primary);
    color: #00030B;
  }

  .btn-email-inline {
    background: var(--color-surface-alt);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .location-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    background: rgba(7, 16, 28, 0.7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1.25rem 1.5rem;
    font-size: 0.8875rem;
  }

  .loc-pin {
    width: 22px;
    height: 22px;
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .loc-sub {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: 0.35rem;
    line-height: 1.5;
  }

  /* Form panel */
  .contact-form-panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 2.25rem 2rem;
  }

  .form-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .form-desc {
    font-size: 0.8875rem;
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
    line-height: 1.6;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-field label {
    font-size: 0.835rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .form-field input,
  .form-field textarea {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.65rem 0.875rem;
    border-radius: 8px;
    font-size: 0.9375rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    border-color: var(--color-primary);
  }

  .btn-submit-inquiry {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--color-primary);
    color: #00030B;
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-pill);
    border: none;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    margin-top: 0.5rem;
  }

  .btn-submit-inquiry:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0, 229, 229, 0.4);
  }

  .submit-arrow {
    width: 18px;
    height: 18px;
    transition: transform 0.2s;
  }

  .btn-submit-inquiry:hover .submit-arrow {
    transform: translateX(3px);
  }

  .form-status {
    padding: 1rem 1.25rem;
    border-radius: 8px;
    font-size: 0.8875rem;
    line-height: 1.6;
  }

  .status-success {
    background: rgba(61, 220, 151, 0.12);
    border: 1px solid var(--color-success);
    color: var(--color-text);
  }

  :global(.status-wa-link) {
    display: inline-block;
    color: #25D366;
    font-weight: 700;
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .channel-card,
    .btn-submit-inquiry,
    .submit-arrow {
      transition: none !important;
    }
  }
</style>
