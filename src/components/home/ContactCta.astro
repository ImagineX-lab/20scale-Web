---
import companyData from '../../../content/company.json';
import type { Lang } from '../../i18n/index';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const whatsapp = companyData.contact?.whatsapp;
const phone = companyData.contact?.phone;
const email = companyData.contact?.email;
const operatingArea = companyData.operatingModel?.serviceArea || 'Sri Lanka';

const waMessage = lang === 'si'
  ? 'හෙලෝ 20Scale, මගේ ව්‍යාපාරයට මෘදුකාංග / POS විසඳුමක් ගැන කතා කිරීමට අවශ්‍යයි.'
  : 'Hello 20Scale, I would like to consult with you regarding a software / POS system for my business.';

const waLink = whatsapp?.link ? `${whatsapp.link}?text=${encodeURIComponent(waMessage)}` : null;
---

<section id="contact-cta" class="cta-section" aria-labelledby="cta-heading">
  <div class="cta-glow" aria-hidden="true"></div>

  <div class="cta-container">
    <div class="cta-card">
      <span class="cta-tag">
        {lang === 'si' ? 'අදම ආරම්භ කරන්න' : 'Get in Touch'}
      </span>

      <h2 id="cta-heading" class="cta-title">
        {lang === 'si' ? (
          <>
            ඔබේ ව්‍යාපාරයේ කටයුතු පහසු කරන <span class="text-cyan">නියම විසඳුම</span> අදම සැලසුම් කරමු
          </>
        ) : (
          <>
            Ready to Build the Reliable <span class="text-cyan">Digital Backbone</span> for Your Store?
          </>
        )}
      </h2>

      <p class="cta-desc">
        {lang === 'si'
          ? 'අප අමතන්න. ඔබගේ ව්‍යාපාරික ස්ථානයට පැමිණ හෝ දුරකථනයෙන් නොමිලේ උපදේශනයක් ලබාදී, ඔබට වඩාත් ගැලපෙන විසඳුම අපි සැලසුම් කරමු.'
          : 'Reach out today for a free discovery consultation. We can visit your store on-site or schedule a call to assess your requirements.'}
      </p>

      <!-- Contact Badges / Action Row -->
      <div class="cta-buttons">
        {waLink && (
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-cta-wa">
            <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-5.805 1.554zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
            </svg>
            <span>WhatsApp: {whatsapp.number}</span>
          </a>
        )}

        {phone?.link && (
          <a href={phone.link} class="btn-cta-phone">
            <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>{phone.number}</span>
          </a>
        )}

        {email && (
          <a href={`mailto:${email}`} class="btn-cta-email">
            <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>{email}</span>
          </a>
        )}
      </div>

      <!-- Verified Island-wide pill -->
      <div class="cta-footnote">
        <span class="footnote-item">
          <svg class="loc-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
          </svg>
          {lang === 'si' ? 'දිවයින පුරා සේවා ස්ථානයට පැමිණීම' : `Service Area: ${operatingArea}`}
        </span>
        <span class="footnote-dot">•</span>
        <span class="footnote-item">
          {lang === 'si' ? '24/7 විමසීම් සඳහා විවෘතයි' : '24/7 Inquiries Open'}
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    padding: 5rem 1.25rem 6rem;
    overflow: hidden;
  }

  .cta-glow {
    position: absolute;
    bottom: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 350px;
    background: radial-gradient(circle, rgba(0, 229, 229, 0.12) 0%, transparent 70%);
    filter: blur(50px);
    pointer-events: none;
  }

  .cta-container {
    max-width: 960px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .cta-card {
    background: linear-gradient(135deg, rgba(7, 16, 28, 0.95) 0%, rgba(11, 23, 38, 0.95) 100%);
    border: 1px solid rgba(0, 229, 229, 0.35);
    border-radius: var(--radius-card);
    padding: 3.5rem 2rem;
    text-align: center;
    box-shadow: 0 0 32px rgba(0, 229, 229, 0.12);
  }

  .cta-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: rgba(0, 229, 229, 0.1);
    padding: 0.25rem 0.875rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.25rem;
  }

  .cta-title {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 1.25rem;
    max-width: 750px;
    margin-left: auto;
    margin-right: auto;
  }

  .text-cyan {
    color: var(--color-primary);
  }

  .cta-desc {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 650px;
    margin: 0 auto 2.5rem;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.25rem;
  }

  .btn-cta-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #25D366;
    color: #00030B;
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.75rem 1.6rem;
    border-radius: var(--radius-pill);
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.35);
  }

  .btn-cta-wa:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(37, 211, 102, 0.5);
  }

  .btn-cta-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--color-primary);
    color: #00030B;
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.75rem 1.6rem;
    border-radius: var(--radius-pill);
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 16px rgba(0, 229, 229, 0.3);
  }

  .btn-cta-phone:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(0, 229, 229, 0.45);
  }

  .btn-cta-email {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-pill);
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  .btn-cta-email:hover {
    background: var(--color-surface-alt);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .btn-icon {
    width: 20px;
    height: 20px;
  }

  .cta-footnote {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .footnote-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .loc-icon {
    width: 14px;
    height: 14px;
    color: var(--color-primary);
  }

  .footnote-dot {
    color: var(--color-border);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-cta-wa,
    .btn-cta-phone,
    .btn-cta-email {
      transition: none !important;
    }
  }
</style>
