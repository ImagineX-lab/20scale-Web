---
import faqData from '../../../content/faq.json';
import type { Lang } from '../../i18n/index';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
const topFaqs = faqData.slice(0, 5);
---

<section class="faq-section" aria-labelledby="faq-heading">
  <div class="faq-container">
    <div class="section-header">
      <span class="section-tag">
        {lang === 'si' ? 'නිතර අසන ප්‍රශ්න' : 'Common Questions'}
      </span>
      <h2 id="faq-heading" class="section-title">
        {lang === 'si' ? (
          <>
            ව්‍යාපාරිකයන් අපෙන් නිතරම <span class="text-cyan">විමසන ප්‍රශ්න</span>
          </>
        ) : (
          <>
            Frequently Asked Questions <span class="text-cyan">Answered Transparently</span>
          </>
        )}
      </h2>
      <p class="section-sub">
        {lang === 'si'
          ? 'මිල ගණන්, තාක්ෂණය සහ සේවාව පිළිබඳ පැහැදිලි තොරතුරු.'
          : 'Clear, direct answers regarding our software architecture, pricing, and hardware.'}
      </p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="faq-list">
      {topFaqs.map((item, idx) => (
        <details class="faq-item" open={idx === 0}>
          <summary class="faq-question">
            <span class="q-text">{item.q[lang]}</span>
            <svg class="chevron-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </summary>
          <div class="faq-answer">
            <p>{item.a[lang]}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- View All Link -->
    <div class="faq-footer-cta">
      <a href={`${prefix}/faq`} class="all-faq-btn">
        <span>{lang === 'si' ? 'සියලු ප්‍රශ්න සහ පිළිතුරු බලන්න' : 'Browse All Frequently Asked Questions'}</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="cta-arrow" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding: 5.5rem 1.25rem;
    position: relative;
  }

  .faq-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: rgba(0, 229, 229, 0.1);
    padding: 0.25rem 0.875rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .text-cyan {
    color: var(--color-primary);
  }

  .section-sub {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .faq-item:hover {
    border-color: rgba(0, 229, 229, 0.4);
  }

  .faq-item[open] {
    border-color: rgba(0, 229, 229, 0.4);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .q-text {
    flex: 1;
  }

  .chevron-icon {
    width: 20px;
    height: 20px;
    color: var(--color-primary);
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .faq-item[open] .chevron-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1.5rem 1.5rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    border-top: 1px solid rgba(18, 40, 58, 0.5);
    margin-top: -0.25rem;
    padding-top: 1rem;
  }

  .faq-footer-cta {
    text-align: center;
  }

  .all-faq-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--color-primary);
    transition: color 0.2s;
  }

  .all-faq-btn:hover {
    color: var(--color-primary);
  }

  .cta-arrow {
    width: 16px;
    height: 16px;
    transition: transform 0.2s;
  }

  .all-faq-btn:hover .cta-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron-icon,
    .all-faq-btn,
    .cta-arrow {
      transition: none !important;
    }
  }
</style>
