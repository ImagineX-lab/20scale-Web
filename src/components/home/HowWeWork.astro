---
import processData from '../../../content/process-support.json';
import type { Lang } from '../../i18n/index';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
const steps = processData.process;
---

<section class="process-section" aria-labelledby="process-heading">
  <div class="process-container">
    <div class="section-header">
      <span class="section-tag">
        {lang === 'si' ? 'අප වැඩ කරන ආකාරය' : 'Transparent 6-Step Process'}
      </span>
      <h2 id="process-heading" class="section-title">
        {lang === 'si' ? (
          <>
            අදහසේ සිට සම්පූර්ණ පද්ධතිය දක්වා <span class="text-cyan">පියවරෙන් පියවර</span>
          </>
        ) : (
          <>
            From First Call to Full Handover: <span class="text-cyan">How We Build For You</span>
          </>
        )}
      </h2>
      <p class="section-sub">
        {lang === 'si'
          ? 'අපගේ ක්‍රමවේදය 100% විනිවිදයි. කිසිදු සැඟවුණු පියවරක් හෝ අනපේක්ෂිත වියදමක් නොමැත.'
          : 'A disciplined, transparent delivery framework engineered around your shop floor reality.'}
      </p>
    </div>

    <!-- Steps Timeline / Grid -->
    <div class="steps-grid">
      {steps.map((step) => (
        <div class="step-card">
          <div class="step-badge">Step 0{step.step}</div>
          <h3 class="step-title">{step.title[lang]}</h3>
          <p class="step-text">{step.text[lang]}</p>
        </div>
      ))}
    </div>

    <!-- Honest Timeline Commitment Banner -->
    <div class="timeline-banner">
      <div class="timeline-header">
        <svg xmlns="http://www.w3.org/2000/svg" class="clock-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="timeline-title">
          {lang === 'si' ? 'යථාර්ථවාදී කාලසටහන (Realistic Timeline)' : 'Realistic Delivery Timelines'}
        </span>
      </div>
      <div class="timeline-items">
        <div class="time-item">
          <span class="time-label">{lang === 'si' ? 'මූලික POS පද්ධතියක්:' : 'Standard Retail POS:'}</span>
          <span class="time-val">{processData.deliveryTime.basicPos[lang]}</span>
        </div>
        <div class="time-divider"></div>
        <div class="time-item">
          <span class="time-label">{lang === 'si' ? 'විශාල / සංකීර්ණ පද්ධති:' : 'Multi-branch / ERP:'}</span>
          <span class="time-val">{processData.deliveryTime.complexSystem[lang]}</span>
        </div>
      </div>
    </div>

    <!-- Section CTA -->
    <div class="process-cta-wrap">
      <a href={`${prefix}/process`} class="process-link-btn">
        <span>{lang === 'si' ? 'අපගේ ක්‍රියාවලිය සහ සහාය ගැන වැඩිදුර කියවන්න' : 'Learn More About Support & Delivery'}</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="btn-arrow" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .process-section {
    padding: 5.5rem 1.25rem;
    position: relative;
  }

  .process-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3.5rem;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: rgba(0, 229, 229, 0.1);
    padding: 0.25rem 0.875rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .text-cyan {
    color: var(--color-primary);
  }

  .section-sub {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 640px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .step-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1.75rem;
    transition: border-color 0.2s, transform 0.2s;
  }

  .step-card:hover {
    border-color: rgba(0, 229, 229, 0.4);
    transform: translateY(-2px);
  }

  .step-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary);
    background: rgba(0, 229, 229, 0.1);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }

  .step-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.625rem;
    line-height: 1.35;
  }

  .step-text {
    font-size: 0.8875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .timeline-banner {
    background: rgba(7, 16, 28, 0.8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.75rem;
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .timeline-banner {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .timeline-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .clock-icon {
    width: 22px;
    height: 22px;
    color: var(--color-primary);
  }

  .timeline-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .timeline-items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .time-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .time-label {
    color: var(--color-text-muted);
  }

  .time-val {
    color: var(--color-primary);
    font-weight: 600;
  }

  .time-divider {
    width: 1px;
    height: 16px;
    background: var(--color-border);
    display: none;
  }

  @media (min-width: 640px) {
    .time-divider {
      display: block;
    }
  }

  .process-cta-wrap {
    text-align: center;
  }

  .process-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--color-primary);
    transition: color 0.2s;
  }

  .process-link-btn:hover {
    color: var(--color-primary);
  }

  .btn-arrow {
    width: 16px;
    height: 16px;
    transition: transform 0.2s;
  }

  .process-link-btn:hover .btn-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .step-card,
    .process-link-btn,
    .btn-arrow {
      transition: none !important;
    }
  }
</style>
