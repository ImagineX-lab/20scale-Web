---
import pricingData from '../../../content/pricing.json';
import type { Lang } from '../../i18n/index';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
const packages = pricingData.packages;
const principles = pricingData.principles;
---

<section class="pricing-section" aria-labelledby="pricing-heading">
  <div class="pricing-container">
    <div class="section-header">
      <span class="section-tag">
        {lang === 'si' ? 'විනිවිද මිල ගණන්' : 'Transparent Pricing'}
      </span>
      <h2 id="pricing-heading" class="section-title">
        {lang === 'si' ? (
          <>
            සැඟවුණු ගාස්තු නැති <span class="text-cyan">පැහැදිලි පැකේජ</span>
          </>
        ) : (
          <>
            Simple, Honest Pricing. <span class="text-cyan">Zero Hidden Charges.</span>
          </>
        )}
      </h2>
      <p class="section-sub">
        {lang === 'si'
          ? 'අපගේ මූලික මිල ගණන් පහත දැක්වේ. සෑම විසඳුමකදීම මිල හැදෙන ආකාරය ඔබට සම්පූර්ණයෙන්ම විනිවිදව පෙන්වනු ලැබේ.'
          : 'Indicative base packages tailored for Sri Lankan businesses. You receive a complete line-by-line breakdown before paying.'}
      </p>
    </div>

    <!-- Pricing Principles Bar -->
    <div class="principles-bar">
      {principles.map((pr) => (
        <div class="principle-item">
          <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span class="principle-text">{pr[lang]}</span>
        </div>
      ))}
    </div>

    <!-- 3 Package Cards -->
    <div class="packages-grid">
      {packages.map((pkg) => (
        <div class:list={['pkg-card', { 'pkg-card-featured': pkg.id === 'desktop' }]}>
          {pkg.id === 'desktop' && (
            <div class="featured-badge">
              {lang === 'si' ? 'වඩාත් ජනප්‍රිය (100% Offline)' : 'Most Popular (100% Offline)'}
            </div>
          )}

          <div class="pkg-header">
            <h3 class="pkg-name">{pkg.name[lang]}</h3>
            <div class="pkg-price-wrap">
              <span class="currency">LKR</span>
              <span class="price-val">{pkg.price.toLocaleString('en-US')}</span>
              <span class="billing-term">/{pkg.billing}</span>
            </div>
            {pkg.recurring && (
              <p class="recurring-note">
                + LKR {pkg.recurring.amount.toLocaleString('en-US')} / {pkg.recurring.period} ({pkg.recurring.label})
              </p>
            )}
          </div>

          <div class="pkg-divider"></div>

          <ul class="pkg-bullets" role="list">
            {pkg.bullets.map((bullet) => (
              <li class="bullet-item">
                <svg class="bullet-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>{bullet[lang]}</span>
              </li>
            ))}
          </ul>

          <div class="pkg-action">
            <a href={`${prefix}/pricing`} class={pkg.id === 'desktop' ? 'btn-pkg-primary' : 'btn-pkg-secondary'}>
              {lang === 'si' ? 'විස්තර සහ Quote එකක් ගන්න' : 'View Details & Get Quote'}
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Footnote -->
    <p class="pricing-disclaimer">
      {lang === 'si'
        ? '* මෙහි පෙන්වා ඇති මිල ගණන් මූලික ඇස්තමේන්තු වේ. අවසාන මිල ව්‍යාපාරයේ අවශ්‍යතා සහ එකඟ වූ වැඩ ප්‍රමාණය අනුව තහවුරු කරනු ලැබේ.'
        : '* Displayed prices are indicative starting prices. Final pricing is confirmed after reviewing your business requirements and agreed scope.'}
    </p>

    <div class="pricing-footer-cta">
      <a href={`${prefix}/pricing`} class="full-pricing-btn">
        <span>{lang === 'si' ? 'සම්පූර්ණ මිල ගණන් සහ විස්තර බලන්න' : 'View Full Pricing Breakdown'}</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="cta-arrow" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    padding: 5.5rem 1.25rem;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .pricing-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3rem;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: rgba(0, 229, 229, 0.1);
    padding: 0.25rem 0.875rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .text-cyan {
    color: var(--color-primary);
  }

  .section-sub {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* Principles */
  .principles-bar {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1.25rem 1.75rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .principles-bar {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .principle-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .check-icon {
    width: 18px;
    height: 18px;
    color: var(--color-success);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .principle-text {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  /* Packages */
  .packages-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .packages-grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: stretch;
    }
  }

  .pkg-card {
    position: relative;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 2.25rem 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, border-color 0.2s;
  }

  .pkg-card:hover {
    border-color: rgba(0, 229, 229, 0.4);
    transform: translateY(-2px);
  }

  .pkg-card-featured {
    border-color: var(--color-primary);
    box-shadow: 0 0 24px rgba(0, 229, 229, 0.15);
  }

  .featured-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: #00030B;
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.2rem 0.85rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .pkg-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .pkg-name {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.875rem;
  }

  .pkg-price-wrap {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem;
    color: var(--color-text);
  }

  .currency {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .price-val {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }

  .billing-term {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .recurring-note {
    font-size: 0.785rem;
    color: var(--color-warning);
    margin-top: 0.5rem;
  }

  .pkg-divider {
    height: 1px;
    background: var(--color-border);
    margin-bottom: 1.5rem;
  }

  .pkg-bullets {
    list-style: none;
    margin-bottom: 2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .bullet-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .bullet-check {
    width: 16px;
    height: 16px;
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .pkg-action {
    margin-top: auto;
  }

  .btn-pkg-primary {
    display: block;
    width: 100%;
    text-align: center;
    background: var(--color-primary);
    color: #00030B;
    font-weight: 700;
    font-size: 0.875rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-pill);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .btn-pkg-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 16px rgba(0, 229, 229, 0.4);
  }

  .btn-pkg-secondary {
    display: block;
    width: 100%;
    text-align: center;
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-pill);
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  .btn-pkg-secondary:hover {
    background: var(--color-surface-alt);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .pricing-disclaimer {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .pricing-footer-cta {
    text-align: center;
  }

  .full-pricing-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--color-primary);
    transition: color 0.2s;
  }

  .full-pricing-btn:hover {
    color: var(--color-primary);
  }

  .cta-arrow {
    width: 16px;
    height: 16px;
    transition: transform 0.2s;
  }

  .full-pricing-btn:hover .cta-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .pkg-card,
    .btn-pkg-primary,
    .btn-pkg-secondary,
    .full-pricing-btn,
    .cta-arrow {
      transition: none !important;
    }
  }
</style>
