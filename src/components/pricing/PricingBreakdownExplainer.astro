---
import type { Lang } from '../../i18n/index';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const breakdownLines = [
  {
    num: '01',
    name: {
      si: 'මෘදුකාංග සංවර්ධනය (Software Development)',
      en: 'Core Software Development'
    },
    desc: {
      si: 'තෝරාගත් base package එක (Desktop, Cloud හෝ Hybrid) ඔබේ ව්‍යාපාරයේ අවශ්‍යතාවලට ගැළපෙන ලෙස සකස් කිරීම.',
      en: 'Core system engineering tailored to your store workflow and business category.'
    }
  },
  {
    num: '02',
    name: {
      si: 'අමතර Cashier Stations (+Rs. 10,000 / station)',
      en: 'Additional Cashier Stations (+Rs. 10,000 / station)'
    },
    desc: {
      si: 'ප්‍රධාන cashier point එකට අමතරව වෙනත් counters හෝ tablets සම්බන්ධ කිරීම සඳහා.',
      en: 'Additional billing terminals or counter points linked to the central store database.'
    }
  },
  {
    num: '03',
    name: {
      si: 'අමතර ශාඛා (+Rs. 15,000 / branch)',
      en: 'Additional Branches (+Rs. 15,000 / branch)'
    },
    desc: {
      si: 'Cloud / Hybrid පද්ධතියකට වෙනත් නගරවල ඇති ශාඛා හෝ ගබඩා සම්බන්ධ කිරීම.',
      en: 'Connecting multi-location shops, warehouses, or remote outlets under one management dashboard.'
    }
  },
  {
    num: '04',
    name: {
      si: 'පළමු වසරේ Hosting (Rs. 18,000 / year - Cloud/Hybrid පමණි)',
      en: 'First Year Cloud Hosting (Rs. 18,000 / yr - Cloud/Hybrid only)'
    },
    desc: {
      si: 'Cloud සහ Hybrid පද්ධති සඳහා අවශ්‍ය සුරක්ෂිත සේවාදායක (Server) සහ ඩේටාබේස් නඩත්තුව.',
      en: 'Secure cloud server infrastructure, automated remote backups, and database uptime for Cloud & Hybrid modes.'
    }
  },
  {
    num: '05',
    name: {
      si: 'Hardware (Vendor සැබෑ මිලට)',
      en: 'Hardware at Vendor Real Price'
    },
    desc: {
      si: 'POS Computers, Thermal Printers, Barcode Scanners සඳහා අපි අතරමැදි ලාභ නොතබා vendor ගේ සැබෑ මිලටම සම්බන්ධ කරමු.',
      en: 'POS computers, thermal receipt printers, and scanners sourced directly at genuine supplier rates.'
    }
  },
  {
    num: '06',
    name: {
      si: 'Data Entry / Migration (Rs. 5,000 / person / day)',
      en: 'Data Migration / Ledger Entry (Rs. 5,000 / person / day)'
    },
    desc: {
      si: 'Excel වල ඇති data නොමිලේ හෝ පොත්පත්වල ඇති ලෙජර් අපගේ කණ්ඩායම පැමිණ ඇතුළත් කිරීම.',
      en: 'Automated digital file imports, or in-person team data entry for physical book records.'
    }
  },
  {
    num: '07',
    name: {
      si: 'ස්ථාපනය සහ කාර්ය මණ්ඩල පුහුණුව (Rs. 7,500)',
      en: 'On-site Installation & Staff Training (Rs. 7,500)'
    },
    desc: {
      si: 'ඔබේ ව්‍යාපාරයට පැමිණ printers, network devices සකසා කාර්ය මණ්ඩලයට ප්‍රායෝගික පුහුණුවක් ලබාදීම.',
      en: 'Complete on-site device setup, driver calibration, receipt layout testing, and intensive staff coaching.'
    }
  },
  {
    num: '08',
    name: {
      si: 'ප්‍රවාහන ගාස්තු (Rs. 100 / km)',
      en: 'On-site Transport (Rs. 100 / km)'
    },
    desc: {
      si: 'දුරස්ථ ප්‍රදේශවලට පැමිණීමේදී පමණක් සැබෑ දුර ප්‍රමාණය අනුව ගණනය කරනු ලබන සාධාරණ ප්‍රවාහන ගාස්තුව.',
      en: 'Fair travel cost estimated based on distance for on-site visits outside our core operating radius.'
    }
  },
  {
    num: '09',
    name: {
      si: 'විශේෂ වට්ටම් / Offer (Discount)',
      en: 'Case-by-case Discount / Custom Offer'
    },
    desc: {
      si: 'ව්‍යාපෘති විෂය පථය සහ සාකච්ඡාව අනුව එකඟ වන විශේෂ අඩුකිරීම්.',
      en: 'Direct deduction applied to total scope upon project agreement.'
    }
  }
];
---

<section class="breakdown-section" aria-labelledby="breakdown-heading">
  <div class="breakdown-container">
    <div class="section-header">
      <span class="section-tag">
        {lang === 'si' ? 'මිල සූත්‍රය' : 'Full Transparency'}
      </span>
      <h2 id="breakdown-heading" class="section-title">
        {lang === 'si' ? (
          <>
            අපගේ Quotation එකක <span class="text-cyan">මිල හැදෙන ආකාරය</span>
          </>
        ) : (
          <>
            The Line-by-Line Breakdown: <span class="text-cyan">How Your Quote Is Built</span>
          </>
        )}
      </h2>
      <p class="section-sub">
        {lang === 'si'
          ? 'අපෙන් ලැබෙන සෑම quote එකකම මෙම පේළි 9 පැහැදිලිව සඳහන් වේ. කිසිදු නොදන්නා හෝ සැඟවුණු අමතර වියදමක් නැත.'
          : 'Every proposal and invoice from 20Scale itemizes these exact 9 components so you have absolute visibility into every cost.'}
      </p>
    </div>

    <div class="breakdown-grid">
      {breakdownLines.map((line) => (
        <div class="breakdown-card">
          <div class="line-top">
            <span class="line-number">{line.num}</span>
            <h3 class="line-name">{line.name[lang]}</h3>
          </div>
          <p class="line-desc">{line.desc[lang]}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .breakdown-section {
    padding: 5.5rem 1.25rem;
    position: relative;
  }

  .breakdown-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3.5rem;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: rgba(0, 229, 229, 0.1);
    padding: 0.25rem 0.875rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .text-cyan {
    color: var(--color-primary);
  }

  .section-sub {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .breakdown-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .breakdown-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .breakdown-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .breakdown-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1.75rem;
    transition: border-color 0.2s, transform 0.2s;
  }

  .breakdown-card:hover {
    border-color: rgba(0, 229, 229, 0.4);
    transform: translateY(-2px);
  }

  .line-top {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .line-number {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-primary);
    background: rgba(0, 229, 229, 0.1);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    line-height: 1;
    flex-shrink: 0;
  }

  .line-name {
    font-family: var(--font-heading);
    font-size: 0.975rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.4;
  }

  .line-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .breakdown-card {
      transition: none !important;
    }
  }
</style>
