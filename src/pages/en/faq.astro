---
import Layout from '../../layouts/Layout.astro';
import FaqFullList from '../../components/faq/FaqFullList.astro';
import ContactCta from '../../components/home/ContactCta.astro';

const lang = 'en' as const;
const title = 'Frequently Asked Questions (FAQ) | 20Scale Solutions';
const description = 'Complete answers regarding offline operations, pricing structures, hardware compatibility, and on-site support.';
