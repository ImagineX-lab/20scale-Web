---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../i18n/index';

const lang = 'en' as const;
const title = t(lang, 'seo.defaultTitle');
const description = t(lang, 'seo.defaultDesc');
---

<Layout title={title} lang={lang} description={description}>
  <section class="hero">
    <div class="hero-inner">
      <h1 class="hero-heading">
        2<span class="hero-zero">0</span>Scale
      </h1>
      <p class="hero-sub">{t(lang, 'page.home.sub')}</p>
      <a href={t(lang, 'page.home.ctaLink')} class="hero-cta">
        {t(lang, 'page.home.cta')}
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    min-height: calc(100dvh - 64px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.25rem;
  }

  .hero-inner {
    max-width: 640px;
    text-align: center;
  }

  .hero-heading {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-text);
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  .hero-zero {
    color: var(--color-primary);
    text-shadow: 0 0 32px rgba(0, 229, 229, 0.4);
  }

  .hero-sub {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 48ch;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    display: inline-block;
    background-color: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-pill);
    padding: 0.625rem 1.75rem;
    font-weight: 600;
    font-size: 0.9375rem;
    transition: background-color 0.2s, color 0.2s;
  }

  .hero-cta:hover {
    background-color: var(--color-primary);
    color: #00030B;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cta {
      transition: none !important;
    }
  }
</style>
