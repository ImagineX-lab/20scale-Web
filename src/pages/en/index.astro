---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/home/Hero.astro';
import BusinessProblems from '../../components/home/BusinessProblems.astro';
import SolutionsOverview from '../../components/home/SolutionsOverview.astro';
import WhyChooseUs from '../../components/home/WhyChooseUs.astro';
import HowWeWork from '../../components/home/HowWeWork.astro';
import PricingPreview from '../../components/home/PricingPreview.astro';
import FaqPreview from '../../components/home/FaqPreview.astro';
import ContactCta from '../../components/home/ContactCta.astro';
import { t } from '../../i18n/index';

const lang = 'en' as const;
const title = t(lang, 'seo.defaultTitle');
const description = t(lang, 'seo.defaultDesc');
---

<Layout title={title} lang={lang} description={description}>
  <Hero lang={lang} />
  <BusinessProblems lang={lang} />
  <SolutionsOverview lang={lang} />
  <WhyChooseUs lang={lang} />
  <HowWeWork lang={lang} />
  <PricingPreview lang={lang} />
  <FaqPreview lang={lang} />
  <ContactCta lang={lang} />
</Layout>
