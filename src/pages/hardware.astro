---
import Layout from '../layouts/Layout.astro';
import HardwareContent from '../components/hardware/HardwareContent.astro';
import ContactCta from '../components/home/ContactCta.astro';
import { getLang } from '../i18n/index';

const lang = getLang(Astro.url); // 'si'
const title = 'Hardware විසඳුම් සහ Vendor සම්බන්ධතාව | 20Scale Solutions';
const description = 'Zero-margin transparent hardware sourcing. POS terminals, thermal printers, barcode scanners සැබෑ වෙළඳපල මිලටම ලබාගන්න.';
---

<Layout title={title} lang={lang} description={description}>
  <HardwareContent lang={lang} />
  <ContactCta lang={lang} />
</Layout>
